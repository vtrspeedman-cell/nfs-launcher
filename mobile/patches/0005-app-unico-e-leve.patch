diff --git a/chrome/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplication.java b/chrome/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplication.java
index b2eff462cf575..8bee575ef97e2 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplication.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplication.java
@@ -221,7 +221,7 @@ public class SplitCompatApplication extends Application {
 
         maybeInitProcessType();
         LibraryLoader.getInstance().setLinkerImplementation(ProductConfig.USE_CHROMIUM_LINKER);
-        ResourceBundle.setAvailablePakLocales(ProductConfig.LOCALES);
+        ResourceBundle.setAvailablePakLocales(new String[] {"en-US", "pt-BR"}); // NFS Launcher
 
         if (isBrowserProcess) {
             // Renderer and GPU processes have command line passed to them via IPC
@@ -229,6 +229,31 @@ public class SplitCompatApplication extends Application {
             CommandLineInitUtil.initCommandLine(
                     COMMAND_LINE_FILE, SplitCompatApplication::shouldUseDebugFlags);
             PathUtils.setPrivateDataDirectorySuffix(PRIVATE_DATA_DIRECTORY_SUFFIX);
+            // NFS Launcher: o navegador por baixo do jogo fica quieto (nada de rede/CPU em segundo plano).
+            org.chromium.base.CommandLine.getInstance()
+                    .appendSwitchesAndArguments(
+                            new String[] {
+                                "--disable-background-networking",
+                                "--disable-component-update",
+                                "--disable-domain-reliability",
+                                "--disable-features=OptimizationHints,MediaRouter",
+                                // Sem a lista de chips bloqueados do WebGPU: Samsung com Xclipse (ex.: A56) só
+                                // funcionava ligando uma opção escondida no Chrome. Quem já era aceito não muda.
+                                "--disable-dawn-features=adapter_blocklist"
+                            });
+            // NFS Launcher: opção "Preparar o jogo ao carregar" (Configurações > Desempenho), ligada por padrão.
+            if (context.getSharedPreferences("nfs", 0).getBoolean("prepareGame", true)) {
+                org.chromium.base.CommandLine.getInstance()
+                        .appendSwitchWithValue(
+                                "js-flags",
+                                "--no-wasm-lazy-compilation --no-wasm-dynamic-tiering");
+            }
+            // NFS Launcher: "Texturas HD" ligada e pacote montado pelo app (files/texturas): o motor o entrega (patch 0007).
+            java.io.File nfsTex = new java.io.File(context.getFilesDir(), "texturas/texturas.ntxp");
+            if (context.getSharedPreferences("nfs", 0).getBoolean("hdTextures", true) && nfsTex.isFile()) {
+                org.chromium.base.CommandLine.getInstance()
+                        .appendSwitchWithValue("nfs-texturas", nfsTex.getAbsolutePath());
+            }
             // Register for activity lifecycle callbacks. Must be done before any activities are
             // created and is needed only by processes that use the ApplicationStatus api (which
             // for Chrome is just the browser process).
